# ProxyAPI Configuration
# Получить ключ: https://console.proxyapi.ru/keys
PROXYAPI_KEY=sk-ВАШ_КЛЮЧ_ЗДЕСЬ

# Модель для обработки диалогов
# Список доступных: https://proxyapi.ru/models
PROXYAPI_MODEL=openai/gpt-5-mini

# Путь к HTML-шаблону (относительно корня проекта)
TEMPLATE_PATH=templates/default.html
